{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splunk-hla-designer.local/schemas/splunk-os-compatibility.schema.json",
  "title": "Splunk OS Compatibility Matrix",
  "type": "object",
  "required": ["schemaVersion", "matrix"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["splunkVersion", "supportedOs"],
        "additionalProperties": false,
        "properties": {
          "splunkVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "supportedOs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "minVersion"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "minVersion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
